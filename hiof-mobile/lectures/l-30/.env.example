# Kopier denne til .env (gitignorert) og fyll inn verdiene fra Appwrite.
# Alle nøkler må ha prefikset EXPO_PUBLIC_ for å være tilgjengelige i appen.
# Endrer du denne filen: start Metro på nytt med `pnpm start --clear`.

# Appwrite → Settings → API Endpoint (f.eks. https://fra.cloud.appwrite.io/v1)
EXPO_PUBLIC_API_URL=

# Appwrite → Settings → Project ID
EXPO_PUBLIC_PROJECT_ID=

# Bundle-id / package name. Må matche app.json (dev.example.studentid)
EXPO_PUBLIC_PLATFORM_ID=

# Appwrite → Databases → Database ID
EXPO_PUBLIC_DATABASE_ID=

# Appwrite → Databases → Collections
EXPO_PUBLIC_STUDENT_COLLECTION_ID=
EXPO_PUBLIC_PROFILE_COLLECTION_ID=
