{
  "expo": {
    "name": "Tasks",
    "slug": "hiof-tasks-demo",
    "scheme": "hioftasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.hiof.tasksdemo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "no.hiof.tasksdemo",
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Appen bruker kameraet til å ta bilde av en oppgave."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
