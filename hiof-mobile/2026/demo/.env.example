# Kopier denne til .env og fyll inn verdiene fra Appwrite.
# Alle nøkler må ha prefikset EXPO_PUBLIC_ for å være tilgjengelige i appen.
# Endrer du denne filen: start Metro på nytt med `pnpm start --clear`.
#
# Lar du fila være tom, kjører appen på mock-provideren med demodata.
# Se APPWRITE.md for hvordan du setter opp prosjektet.

# Appwrite → Settings → API Endpoint (f.eks. https://fra.cloud.appwrite.io/v1)
EXPO_PUBLIC_API_URL=

# Appwrite → Settings → Project ID
EXPO_PUBLIC_PROJECT_ID=

# Bundle identifier / package name, f.eks. no.hiof.tasksdemo
EXPO_PUBLIC_PLATFORM_ID=

# Appwrite → Databases → Database ID
EXPO_PUBLIC_DATABASE_ID=

# Tabell-ID for tasks
EXPO_PUBLIC_TASKS_TABLE_ID=

# Storage → Bucket ID for bilder
EXPO_PUBLIC_BUCKET_ID=
