{
  "name": "kvitter",
  "version": "1.0.0",
  "description": "Kvitter — ferdig mikroblogg fra kurset Webapplikasjoner 2026 (RedwoodSDK + Cloudflare Workers + Better Auth + Drizzle/D1 + Workers AI + Vectorize + R2)",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "release": "bash scripts/release.sh",
    "generate": "wrangler types --include-runtime false",
    "types": "tsc",
    "check": "npm run generate && npm run types",
    "seed": "rwsdk worker-run ./scripts/seed.ts",
    "seed:windows": "node ./scripts/run-seed-windows.mjs",
    "index:posts": "rwsdk worker-run ./scripts/index-existing-posts.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "dependencies": {
    "better-auth": "1.6.20",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "rwsdk": "1.7.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "~26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
