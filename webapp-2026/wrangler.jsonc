{
  // Schema reference — gives editors autocomplete and validation for this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name. It is also the subdomain: <name>.workers.dev until a custom
  // domain is attached.
  "name": "kvitter",
  "main": "src/worker.tsx",
  // `nodejs_compat` is required by better-auth, which assumes Node globals.
  // `compatibility_date` pins runtime behaviour — moving it forward can change
  // the semantics of existing code, so bump it deliberately and redeploy.
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  // Static files. rwsdk expects this binding to exist; the directory is public/.
  "assets": {
    "binding": "ASSETS",
    "directory": "public"
  },
  // `head_sampling_rate: 1` logs every request. That is affordable at this
  // traffic level and makes `wrangler tail` show the whole picture — lower it
  // if volume ever grows.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Public vars — anyone who can reach the worker can read these, so secrets
  // never go here. BETTER_AUTH_SECRET is set with `wrangler secret put`
  // (locally: .dev.vars).
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
    "PUBLIC_URL": "http://localhost:5173"
  },
  // D1 (SQLite at the edge). Create it with `wrangler d1 create kvitter-db`
  // and paste the returned id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kvitter-db",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "drizzle/migrations",
      // Drizzle v1 writes each migration into its own folder
      // (`<timestamp>_<name>/migration.sql`). Without this pattern wrangler
      // finds no migrations at all and reports "No migrations to apply".
      "migrations_pattern": "drizzle/migrations/*/migration.sql"
    }
  ],
  // Workers AI — hashtag suggestions and the embeddings behind semantic
  // search. AI has no local emulation: the binding always calls Cloudflare,
  // and `remote: true` lets `pnpm dev` reach the real service. In dev the call
  // therefore leaves your own machine, so a slow link can trip TIMEOUT_MS in
  // src/routes/ai.ts. Without the binding /api/ai/hashtags answers 503 and the
  // rest of the app keeps working.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Vectorize — the vector index for semantic search / RAG. The 768 dimensions
  // must match the embedding model (@cf/google/embeddinggemma-300m); vectors
  // of any other size are rejected on insert. Create the index first:
  //   wrangler vectorize create kvitter-posts-index --dimensions=768 --metric=cosine
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "kvitter-posts-index",
      "remote": true
    }
  ],
  // R2 — object storage for avatars and post images. `preview_bucket_name` is
  // the bucket `pnpm dev` writes to, so local experiments never touch the
  // deployed data. Create the bucket first:
  //   wrangler r2 bucket create kvitter-files
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "kvitter-files",
      "preview_bucket_name": "kvitter-files-dev"
    }
  ],
  // Cron triggers, always in UTC: cleanup at 03:00 and trending every 4 hours.
  // Both expressions fire the same `scheduled` handler, which discriminates on
  // the string — so they must match the constants in src/scheduled/index.ts
  // exactly, character for character.
  "triggers": {
    "crons": ["0 3 * * *", "0 */4 * * *"]
  },
  // Rate limiting — an abuse brake on the endpoints that cost money. This is a
  // RUNTIME binding, not a zone feature: it works on workers.dev, where the
  // WAF does not exist at all. See DEPLOY.md §10.
  //
  // `period` MUST be 10 or 60 — any other value is rejected at deploy time.
  // `namespace_id` is an arbitrary positive integer string that only has to be
  // unique within the account; the number itself carries no meaning.
  //
  // The count is local to each Cloudflare location and eventually consistent.
  // It removes cheap abuse; it is not exact accounting, and a distributed
  // attacker can exceed the limit.
  "ratelimits": [
    {
      // Workers AI calls. Strictest, because this is the only thing in the app
      // that costs money per call.
      "name": "AI_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Image upload. Counts per user id rather than IP (see media.ts): the
      // caller is already signed in, and a user key is the fair one when
      // several people share a single NAT address.
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Sign-in and sign-up — the calls that create rows and cost D1 reads.
      // Roomy enough for a group behind one shared IP, tight enough that
      // credential stuffing is slow. Session lookups are deliberately not
      // throttled here; they run on every page view (see routes/auth.ts).
      "name": "AUTH_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
